// The subset of wasi-gfx:surface@0.2.0 (github.com/wasi-gfx/wasi-gfx,
// packages/surface) this engine serves, declared here with the same
// package, interface, type and function names and signatures so a guest
// built against the upstream WIT links against it. The upstream repository
// publishes no license, so its files are not copied; the input-event
// functions (which return streams) are not served yet.
package wasi-gfx:surface@0.2.0;

interface surface {
  record create-desc {
    height: option<u32>,
    width: option<u32>,
  }

  resource surface {
    constructor(desc: create-desc);
    height: func() -> u32;
    width: func() -> u32;
    request-set-size: func(height: option<u32>, width: option<u32>);
  }
}

interface surface-webgpu {
  use wasi:webgpu/webgpu@0.3.0-rc.2.{gpu-device, gpu-texture, gpu-texture-format, gpu-texture-usage, predefined-color-space, gpu-canvas-tone-mapping, gpu-canvas-alpha-mode};
  use surface.{surface};

  record context-configuration {
    device: borrow<gpu-device>,
    format: gpu-texture-format,
    usage: option<gpu-texture-usage>,
    view-formats: option<list<gpu-texture-format>>,
    color-space: option<predefined-color-space>,
    tone-mapping: option<gpu-canvas-tone-mapping>,
    alpha-mode: option<gpu-canvas-alpha-mode>,
  }

  resource context {
    constructor(surface: borrow<surface>);
    configure: func(configuration: context-configuration);
    unconfigure: func();
    get-current-texture: func() -> gpu-texture;
    present: func();
  }
}
